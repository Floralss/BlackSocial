rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isMe(uid) { return signedIn() && request.auth.uid == uid; }

    match /users/{userId} {
      allow read: if signedIn();
      allow create: if isMe(userId);
      allow update: if isMe(userId);
      allow delete: if isMe(userId);
    }

    match /chats/{chatId} {
      allow read: if signedIn() && request.auth.uid in resource.data.members;
      allow create: if signedIn();
      allow update: if signedIn() && request.auth.uid in resource.data.members;
      allow delete: if signedIn() && request.auth.uid in resource.data.admins;

      match /messages/{msgId} {
        allow read: if signedIn();
        allow create: if signedIn();
        allow update, delete: if signedIn() &&
          (resource.data.senderId == request.auth.uid || request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.admins);
      }
    }

    // Pending gifts/coins/nft — recipient claims by updating OWN user doc;
    // transfer docs readable by from/to
    match /transfers/{id} {
      allow read: if signedIn() &&
        (resource.data.toUid == request.auth.uid || resource.data.fromUid == request.auth.uid);
      allow create: if signedIn() && request.resource.data.fromUid == request.auth.uid;
      allow update: if signedIn() &&
        (resource.data.toUid == request.auth.uid || resource.data.fromUid == request.auth.uid);
    }

    match /calls/{id} {
      allow read, write: if signedIn();
      match /{sub=**} {
        allow read, write: if signedIn();
      }
    }

    match /nfts/{id} {
      allow read: if signedIn();
      allow write: if signedIn();
    }

    match /giftCatalog/{id} {
      allow read: if signedIn();
      allow write: if signedIn();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
